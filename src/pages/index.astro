---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import RadarDashboard from '../components/RadarDashboard';
import { isProgramOpen, getRemainingDays } from '../utils/programs';

const allPrograms = await getCollection('programs');

// CRITICAL USER REQUIREMENT: Filter ONLY programs that are still open for applications!
const now = new Date();
const openPrograms = allPrograms
  .filter((p) => isProgramOpen(p, now))
  .sort((a, b) => {
    // Sort by earliest closing deadline first (rolling at the end)
    if (a.data.isRolling && !b.data.isRolling) return 1;
    if (!a.data.isRolling && b.data.isRolling) return -1;
    return new Date(a.data.closingDate).getTime() - new Date(b.data.closingDate).getTime();
  });

// Format serialized items for React components
const programItems = openPrograms.map((p) => {
  const daysLeft = getRemainingDays(p.data.closingDate, now);
  return {
    id: p.id,
    ticker: p.data.ticker,
    name: p.data.name,
    organizer: p.data.organizer,
    tagline: p.data.tagline,
    logo: p.data.logo,
    bannerImage: p.data.bannerImage,
    website: p.data.website,
    applyUrl: p.data.applyUrl,
    closingDate: p.data.closingDate,
    isRolling: p.data.isRolling,
    durationWeeks: p.data.durationWeeks,
    cohortStart: p.data.cohortStart,
    location: p.data.location,
    sectors: p.data.sectors,
    stage: p.data.stage,
    terms: p.data.terms,
    hardwareFacilities: p.data.hardwareFacilities,
    perks: p.data.perks,
    notableAlumni: p.data.notableAlumni,
    badge: p.data.badge,
    daysLeft,
    isUrgent: daysLeft <= 7 && !p.data.isRolling,
  };
});
---

<Layout title="Radar for Physical AI & Hardware Accelerators">
  <!-- Neo-Brutal Pop Main Surface -->
  <div class="bg-[#F4EFE6] text-black min-h-screen">
    <!-- Hero Header (Frontier Neo-Brutal Pop) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-10 pb-6 sm:pb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 sm:gap-6 border-b-2 border-black pb-8">
        <div>
          <!-- Cadmium yellow pill -->
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-black mb-3 px-3 sm:px-3.5 py-1.5 rounded-full bg-[#FFE600] border-2 border-black shadow-[2px_2px_0px_#000]">
            <span>⚡ FRONTIER ACCELERATOR RADAR</span>
            <span class="text-black font-black">·</span>
            <span>GLOBAL PIPELINE</span>
          </div>
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-black tracking-tight leading-tight break-words">
            Physical AI & Hardware Accelerators
          </h1>
          <p class="text-sm sm:text-lg text-slate-800 font-medium mt-3 max-w-2xl leading-relaxed">
            Tracking every active incubator and accelerator program currently accepting applications for
            <strong class="text-black font-black underline decoration-2 decoration-[#FFE600]"> Physical AI, Robotics, Custom Silicon, and Advanced Electronics</strong>.
            Verified open closing dates, in-house hardware specs, and deal terms.
          </p>
        </div>

        <!-- Cohort counter card: Mint green box with border-2 border-black shadow-[4px_4px_0px_#000] p-4 font-mono font-bold text-black -->
        <div class="flex items-center gap-3.5 bg-[#34D399] border-2 border-black shadow-[4px_4px_0px_#000] p-3.5 sm:p-4 rounded-xl font-mono font-bold text-black w-full md:w-auto">
          <span class="relative flex h-3.5 w-3.5 flex-shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-black opacity-40"></span>
            <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-black"></span>
          </span>
          <div>
            <div class="text-sm sm:text-base font-black text-black">{openPrograms.length} Verified Open Cohorts</div>
            <div class="text-[10px] sm:text-[11px] text-black/80 font-bold uppercase tracking-wider">Auto-excluding expired deadlines</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Dashboard: KPIs, Search, Filter Tabs & Program Cards -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <RadarDashboard client:load initialPrograms={programItems} />
    </div>
  </div>
</Layout>
