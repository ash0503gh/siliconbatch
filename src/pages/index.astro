---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import LiveTicker from '../components/LiveTicker';
import RadarDashboard from '../components/RadarDashboard';
import { isProgramOpen, getRemainingDays } from '../utils/programs';

const allPrograms = await getCollection('programs');

// CRITICAL USER REQUIREMENT: Filter ONLY programs that are still open for applications!
const now = new Date();
const openPrograms = allPrograms
  .filter((p) => isProgramOpen(p, now))
  .sort((a, b) => {
    // Sort by earliest closing deadline first (rolling at the end)
    if (a.data.isRolling && !b.data.isRolling) return 1;
    if (!a.data.isRolling && b.data.isRolling) return -1;
    return new Date(a.data.closingDate).getTime() - new Date(b.data.closingDate).getTime();
  });

// Format serialized items for React components
const programItems = openPrograms.map((p) => {
  const daysLeft = getRemainingDays(p.data.closingDate, now);
  return {
    id: p.id,
    ticker: p.data.ticker,
    name: p.data.name,
    organizer: p.data.organizer,
    tagline: p.data.tagline,
    logo: p.data.logo,
    bannerImage: p.data.bannerImage,
    website: p.data.website,
    applyUrl: p.data.applyUrl,
    closingDate: p.data.closingDate,
    isRolling: p.data.isRolling,
    durationWeeks: p.data.durationWeeks,
    cohortStart: p.data.cohortStart,
    location: p.data.location,
    sectors: p.data.sectors,
    stage: p.data.stage,
    terms: p.data.terms,
    hardwareFacilities: p.data.hardwareFacilities,
    perks: p.data.perks,
    notableAlumni: p.data.notableAlumni,
    badge: p.data.badge,
    daysLeft,
    isUrgent: daysLeft <= 7 && !p.data.isRolling,
  };
});

// Ticker items for continuous marquee
const tickerItems = programItems.map((p) => ({
  id: p.id,
  ticker: p.ticker,
  name: p.name,
  check: p.terms.checkDisplay,
  daysLeft: p.daysLeft,
  isRolling: p.isRolling,
  city: p.location.city,
  country: p.location.country,
}));
---

<Layout title="Radar for Physical AI & Hardware Accelerators">
  <!-- Live Stock Ticker Bar -->
  <LiveTicker client:load items={tickerItems} />

  <!-- Hero Header (Frontier Foundry) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-white/5 pb-8">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-indigo-400 font-semibold mb-3 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20">
          <span>⚡ FRONTIER ACCELERATOR RADAR</span>
          <span class="text-slate-600">·</span>
          <span class="text-sky-400">GLOBAL PIPELINE</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
          Physical AI & Hardware Accelerators
        </h1>
        <p class="text-sm sm:text-base text-slate-400 mt-3 max-w-2xl leading-relaxed">
          Tracking every active incubator and accelerator program currently accepting applications for
          <strong class="text-white font-semibold"> Physical AI, Robotics, Custom Silicon, and Advanced Electronics</strong>.
          Verified closing dates, in-house hardware lab specs, and deal terms.
        </p>
      </div>

      <!-- Quick status indicator badge -->
      <div class="flex items-center gap-3.5 bg-white/[0.03] border border-white/10 px-4 py-3 rounded-2xl font-mono text-xs backdrop-blur-xl shadow-glow">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <div>
          <div class="text-white font-bold">{openPrograms.length} Verified Open Cohorts</div>
          <div class="text-[10px] text-slate-500">Auto-excluding expired deadlines</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Dashboard: KPIs, Search, Filter Tabs & Program Cards -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <RadarDashboard client:load initialPrograms={programItems} />
  </div>
</Layout>
