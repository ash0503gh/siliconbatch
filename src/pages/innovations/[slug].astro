---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const innovations = await getCollection('innovations');
  return innovations.map((innovation) => ({
    params: { slug: innovation.id },
    props: { innovation },
  }));
}

const { innovation } = Astro.props;
const { Content } = await render(innovation);
const data = innovation.data;

// Extract primary architecture if present in specs
const architectureValue =
  data.specs?.Architecture ||
  data.specs?.architecture ||
  data.specs?.['Model Architecture'] ||
  data.specs?.Framework ||
  data.specs?.['Compute Hardware'] ||
  'Proprietary Frontier';
---

<Layout
  title={`${data.title} (${data.ticker}) - Frontier Innovation Dossier`}
  description={`${data.title} by ${data.organization}: ${data.tagline}. Impact Metric: ${data.impactMetric}.`}
>
  <!-- Main Neo-Brutal Pop Wrapper -->
  <div class="bg-[#F4EFE6] text-black min-h-screen font-sans pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <!-- Breadcrumb Link Back to Innovations Radar -->
      <div class="mb-7 flex flex-wrap items-center justify-between gap-3">
        <a
          href="/innovations"
          class="inline-flex items-center gap-2 text-xs font-mono font-bold text-black bg-white border-2 border-black shadow-[3px_3px_0px_#000] px-4 py-2 rounded-xl hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_#000] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none transition-all group"
        >
          <span class="transform group-hover:-translate-x-1 transition-transform font-black">←</span>
          <span>Back to Innovations Radar</span>
        </a>

        <div class="flex items-center gap-2 font-mono text-xs">
          <span class="bg-[#FFE600] text-black border-2 border-black shadow-[2px_2px_0px_#000] px-3 py-1 rounded-xl font-black">
            ${data.ticker}
          </span>
          <span class="bg-[#34D399] text-black border-2 border-black shadow-[2px_2px_0px_#000] px-3 py-1 rounded-xl font-bold">
            {data.status}
          </span>
        </div>
      </div>

      <!-- Hero Card (Neo-Brutal Pop White Card) -->
      <div class="bg-white border-[2.5px] border-black shadow-[5px_5px_0px_#000] sm:shadow-[6px_6px_0px_#000] p-6 sm:p-10 mb-8 rounded-2xl relative overflow-hidden">
        <!-- Top Badge Stickers -->
        <div class="flex flex-wrap items-center gap-2 mb-5">
          <span class="bg-slate-100 text-black border-2 border-black shadow-[2px_2px_0px_#000] font-mono font-black text-xs px-3 py-1 rounded-lg">
            ${data.ticker}
          </span>
          <span class="bg-[#93C5FD] text-black border-2 border-black shadow-[2px_2px_0px_#000] font-mono font-bold text-xs px-3 py-1 rounded-lg">
            {data.domain}
          </span>
          {data.country && (
            <span class="bg-white text-black border-2 border-black shadow-[2px_2px_0px_#000] font-mono font-bold text-xs px-3 py-1 rounded-lg">
              {data.country.includes('China') ? '🇨🇳 ' : data.country.includes('USA') ? '🇺🇸 ' : data.country.includes('France') ? '🇫🇷 ' : '🌐 '}{data.country}
            </span>
          )}
          <span class="bg-[#34D399] text-black border-2 border-black shadow-[2px_2px_0px_#000] font-mono font-black text-xs px-3 py-1 rounded-lg">
            {data.status}
          </span>
          <span class="bg-yellow-200 text-black border border-black shadow-[1px_1px_0px_#000] font-mono font-bold text-xs px-3 py-1 rounded-lg">
            Released {data.releaseDate}
          </span>
          {data.badge && (
            <span class="bg-[#FF5E7E] text-black border-2 border-black shadow-[2px_2px_0px_#000] font-mono font-bold text-xs px-3 py-1 rounded-lg uppercase">
              {data.badge}
            </span>
          )}
        </div>

        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 sm:gap-8">
          <div class="flex items-start gap-4 sm:gap-6 flex-1">
            {data.image && (
              <img
                src={data.image}
                alt={`${data.title} graphic`}
                class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover border-2 border-black shadow-[3px_3px_0px_#000] bg-white flex-shrink-0"
                onerror="this.style.display='none'"
              />
            )}
            <div class="flex-1 min-w-0">
              <div class="text-xs sm:text-sm font-mono font-black text-slate-600 uppercase tracking-wider mb-1">
                {data.organization}
              </div>
              <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight leading-tight break-words">
                {data.title}
              </h1>
              <p class="text-base sm:text-xl text-slate-800 font-medium mt-2 max-w-3xl leading-relaxed">
                {data.tagline}
              </p>

              <!-- Impact Metric Pill -->
              <div class="mt-4">
                <span class="inline-flex items-center gap-2 bg-[#FFE600] text-black border-2 border-black font-mono font-black text-xs sm:text-sm px-3.5 py-1.5 rounded-xl shadow-[2px_2px_0px_#000]">
                  <span>⚡ Impact Metric:</span>
                  <span>{data.impactMetric}</span>
                </span>
              </div>
            </div>
          </div>

          <!-- Direct External Action Buttons -->
          <div class="flex flex-row lg:flex-col gap-2.5 flex-shrink-0 w-full lg:w-auto">
            {data.links?.paperUrl && (
              <a
                href={data.links.paperUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 lg:flex-none text-center bg-[#FFE600] hover:bg-[#FACC15] text-black border-2 border-black shadow-[3px_3px_0px_#000] font-mono font-black text-xs sm:text-sm px-6 py-3 rounded-xl hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1.5px_1.5px_0px_#000] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all uppercase"
              >
                📄 Read Paper ↗
              </a>
            )}
            {data.links?.githubUrl && (
              <a
                href={data.links.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 lg:flex-none text-center bg-[#34D399] hover:bg-emerald-400 text-black border-2 border-black shadow-[3px_3px_0px_#000] font-mono font-black text-xs sm:text-sm px-6 py-3 rounded-xl hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1.5px_1.5px_0px_#000] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all uppercase"
              >
                💻 GitHub Repo ↗
              </a>
            )}
            {data.links?.demoUrl && (
              <a
                href={data.links.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 lg:flex-none text-center bg-white hover:bg-yellow-50 text-black border-2 border-black shadow-[3px_3px_0px_#000] font-mono font-bold text-xs sm:text-sm px-6 py-3 rounded-xl hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1.5px_1.5px_0px_#000] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
              >
                🎬 Watch Demo ↗
              </a>
            )}
            {data.links?.website && (
              <a
                href={data.links.website}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 lg:flex-none text-center bg-[#F7F2E8] hover:bg-yellow-100 text-black border-2 border-black shadow-[3px_3px_0px_#000] font-mono font-bold text-xs sm:text-sm px-6 py-3 rounded-xl hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1.5px_1.5px_0px_#000] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
              >
                🌐 Official Site ↗
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- 6-Metric Specs Bento Grid (Architecture, Organization, Status, Release Date, Benchmark Metric, Domain) -->
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-8">
        {/* 1. Architecture Card (Cadmium Yellow) */}
        <div class="bg-[#FFE600] border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all">
          <div class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-black/80 mb-2">
            ARCHITECTURE & MODEL
          </div>
          <div class="text-lg sm:text-2xl font-black font-mono text-black truncate" title={architectureValue}>
            {architectureValue}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-black/80 mt-1">
            Technical Foundation
          </div>
        </div>

        {/* 2. Organization Card (Cobalt / Sky Blue) */}
        <div class="bg-[#93C5FD] border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all">
          <div class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-black/80 mb-2">
            RESEARCH LAB / ORG
          </div>
          <div class="text-lg sm:text-2xl font-black font-mono text-black truncate" title={data.organization}>
            {data.organization}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-black/80 mt-1">
            Breakthrough Creators
          </div>
        </div>

        {/* 3. Status Card (Mint Green) */}
        <div class="bg-[#34D399] border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all">
          <div class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-black/80 mb-2">
            DEPLOYMENT STATUS
          </div>
          <div class="text-lg sm:text-2xl font-black font-mono text-black truncate">
            {data.status}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-black/80 mt-1">
            Operational Lifecycle
          </div>
        </div>

        {/* 4. Release Date Card (White) */}
        <div class="bg-white border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all">
          <div class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-slate-600 mb-2">
            RELEASE DATE
          </div>
          <div class="text-base sm:text-xl font-black font-mono text-black">
            📅 {data.releaseDate}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-slate-600 mt-1">
            Dispatch Timeline
          </div>
        </div>

        {/* 5. Benchmark Metric Card (Cadmium Yellow / Mint Accent) */}
        <div class="bg-white border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all">
          <div class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-slate-600 mb-2">
            BENCHMARK METRIC
          </div>
          <div class="text-sm sm:text-base font-black font-mono text-black truncate" title={data.impactMetric}>
            ⚡ {data.impactMetric}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-slate-600 mt-1">
            Verified Performance
          </div>
        </div>

        {/* 6. Domain Card (Coral Pink) */}
        <div class="bg-[#FF8DA1] border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all">
          <div class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-black/80 mb-2">
            FRONTIER DOMAIN
          </div>
          <div class="text-sm sm:text-lg font-black font-mono text-black truncate" title={data.domain}>
            {data.domain}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-black/80 mt-1">
            Technology Category
          </div>
        </div>
      </div>

      {/* Comprehensive Specs Sheet (if specs exist) */}
      {data.specs && Object.keys(data.specs).length > 0 && (
        <div class="bg-white border-[2.5px] border-black shadow-[5px_5px_0px_#000] p-6 sm:p-8 rounded-2xl mb-8">
          <div class="flex items-center justify-between mb-4 pb-3 border-b-2 border-black flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <span class="text-xl">⚙️</span>
              <h2 class="text-base sm:text-xl font-black font-mono uppercase tracking-tight text-black">
                Technical Architecture & Hardware Specifications
              </h2>
            </div>
            <span class="text-xs font-mono font-bold bg-[#FFE600] border-2 border-black px-2.5 py-1 rounded-lg shadow-[1.5px_1.5px_0px_#000]">
              {Object.keys(data.specs).length} Verified Specs
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {Object.entries(data.specs).map(([specKey, specVal]) => (
              <div class="bg-[#F7F2E8] border-2 border-black p-3.5 rounded-xl shadow-[2px_2px_0px_#000]">
                <div class="text-[10px] font-mono font-extrabold text-slate-600 uppercase tracking-wider">
                  {specKey}
                </div>
                <div class="text-sm font-black font-mono text-black mt-1 break-words">
                  {specVal}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Tags Stickers Section */}
      {data.tags && data.tags.length > 0 && (
        <div class="bg-white border-[2.5px] border-black shadow-[5px_5px_0px_#000] p-6 sm:p-8 rounded-2xl mb-8">
          <div class="flex items-center justify-between mb-4 pb-3 border-b-2 border-black flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <span class="text-xl">🏷️</span>
              <h2 class="text-base sm:text-xl font-black font-mono uppercase tracking-tight text-black">
                Domain Tags & Keywords
              </h2>
            </div>
            <span class="text-xs font-mono font-bold bg-yellow-100 border border-black px-2 py-0.5 rounded shadow-[1px_1px_0px_#000]">
              {data.tags.length} Tags
            </span>
          </div>
          <div class="flex flex-wrap gap-2 sm:gap-2.5">
            {data.tags.map((tag: string) => (
              <span class="bg-yellow-100 text-black border-2 border-black font-mono font-bold text-xs sm:text-sm px-3.5 py-1.5 rounded-xl shadow-[2px_2px_0px_#000]">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

      {/* High-Contrast Markdown Body (Dossier, Breakthrough Architecture, Benchmark Results) */}
      <div class="bg-white border-[2.5px] border-black shadow-[5px_5px_0px_#000] sm:shadow-[6px_6px_0px_#000] p-6 sm:p-10 rounded-2xl">
        <div class="text-xs font-mono font-black uppercase tracking-wider text-slate-500 mb-6 flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#FFE600] border border-black"></span>
          <span>Breakthrough Deep Dive & Technical Dossier</span>
        </div>
        <article class="prose prose-slate max-w-none prose-headings:font-black prose-headings:text-black prose-headings:tracking-tight prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:border-b-2 prose-h2:border-black prose-h2:pb-2 prose-h2:mt-8 prose-h2:mb-4 prose-p:text-slate-800 prose-p:text-base sm:prose-p:text-lg prose-p:leading-relaxed prose-strong:text-black prose-strong:font-black prose-li:text-slate-800 prose-li:text-base prose-ul:my-4 prose-li:my-1">
          <Content />
        </article>
      </div>
    </div>
  </div>
</Layout>
