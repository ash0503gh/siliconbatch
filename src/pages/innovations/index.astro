---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import InnovationsDashboard, { type InnovationItem } from '../../components/InnovationsDashboard';

let allInnovations: any[] = [];
try {
  allInnovations = await getCollection('innovations');
} catch (e) {
  allInnovations = [];
}

// Sort alphabetically by innovation title
const sortedInnovations = [...allInnovations].sort((a, b) => {
  return (a.data.title || '').localeCompare(b.data.title || '');
});

// Format serialized items for React component
const serializedInnovations: InnovationItem[] = sortedInnovations.map((item) => ({
  id: item.id,
  ticker: item.data.ticker,
  title: item.data.title,
  tagline: item.data.tagline,
  domain: item.data.domain,
  organization: item.data.organization,
  country: item.data.country,
  releaseDate: item.data.releaseDate,
  impactMetric: item.data.impactMetric,
  status: item.data.status,
  badge: item.data.badge,
  specs: item.data.specs || {},
  tags: item.data.tags || [],
  links: item.data.links || {},
  image: item.data.image,
  bannerImage: item.data.bannerImage,
}));
---

<Layout
  title="Frontier Innovations Radar"
  description="Tracking breakthroughs across Physical AI, Robotics, Hardware Accelerators, Autonomous Systems, and Open Model Weights."
>
  <!-- Neo-Brutal Pop Main Surface -->
  <div class="bg-[#F4EFE6] text-black min-h-screen">
    <!-- Hero Header (Frontier Neo-Brutal Pop) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-10 pb-6 sm:pb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 sm:gap-6 border-b-2 border-black pb-8">
        <div>
          <!-- Cadmium yellow pill -->
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-black mb-3 px-3 sm:px-3.5 py-1.5 rounded-full bg-[#FFE600] border-2 border-black shadow-[2px_2px_0px_#000]">
            <span>🔬 FRONTIER TECH & PHYSICAL AI · BREAKTHROUGHS RADAR</span>
            <span class="text-black font-black">·</span>
            <span>LIVE DISPATCHES</span>
          </div>
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-black tracking-tight leading-tight break-words">
            Frontier Innovations Radar
          </h1>
          <p class="text-sm sm:text-lg text-slate-800 font-medium mt-3 max-w-2xl leading-relaxed">
            The curated directory of frontier technical breakthroughs across{' '}
            <strong class="text-black font-black underline decoration-2 decoration-[#FFE600]">
              Physical AI & Robotics, Hardware & Frontier Silicon, Autonomous Aerospace, and Foundation Models
            </strong>.
            Verified impact benchmarks, specs dossiers, open source repos, and research papers.
          </p>
        </div>

        <!-- Live counter badge: Mint green box with border-2 border-black shadow-[4px_4px_0px_#000] p-4 font-mono font-bold text-black -->
        <div class="flex items-center gap-3.5 bg-[#34D399] border-2 border-black shadow-[4px_4px_0px_#000] p-3.5 sm:p-4 rounded-xl font-mono font-bold text-black w-full md:w-auto flex-shrink-0">
          <span class="relative flex h-3.5 w-3.5 flex-shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-black opacity-40"></span>
            <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-black"></span>
          </span>
          <div>
            <div class="text-sm sm:text-base font-black text-black">
              {allInnovations.length} Active Breakthroughs
            </div>
            <div class="text-[10px] sm:text-[11px] text-black/80 font-bold uppercase tracking-wider">
              Physical AI & Hardware Pipeline
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Dashboard: KPIs, Search, Filter Tabs & Bento Cards -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <InnovationsDashboard client:load initialInnovations={serializedInnovations} />
    </div>
  </div>
</Layout>
