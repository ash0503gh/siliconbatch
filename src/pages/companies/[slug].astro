---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map((company) => ({
    params: { slug: company.id },
    props: { company },
  }));
}

const { company } = Astro.props;
const { Content } = await render(company);
const data = company.data;
---

<Layout
  title={`${data.name} (YC ${data.batch}) Profile & Architecture`}
  description={`${data.name} (YC ${data.batch}): ${data.tagline}. Key technologies, founders, and funding terms.`}
>
  <!-- Main Neo-Brutal Pop Wrapper -->
  <div class="bg-[#F4EFE6] text-black min-h-screen font-sans pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <!-- Breadcrumb Link Back to Directory -->
      <div class="mb-7 flex flex-wrap items-center justify-between gap-3">
        <a
          href="/companies"
          class="inline-flex items-center gap-2 text-xs font-mono font-bold text-black bg-white border-2 border-black shadow-[3px_3px_0px_#000] px-4 py-2 rounded-xl hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_#000] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none transition-all group"
        >
          <span class="transform group-hover:-translate-x-1 transition-transform font-black">←</span>
          <span>Back to YC Startups Directory</span>
        </a>

        <div class="flex items-center gap-2 font-mono text-xs">
          <span class="bg-[#FFE600] text-black border-2 border-black shadow-[2px_2px_0px_#000] px-3 py-1 rounded-xl font-bold">
            YC {data.batch}
          </span>
          {data.hiring && (
            <span class="bg-[#34D399] text-black border-2 border-black shadow-[2px_2px_0px_#000] px-3 py-1 rounded-xl font-bold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-black animate-pulse"></span>
              <span>Actively Hiring {data.openRolesCount > 0 ? `(${data.openRolesCount} roles)` : ''}</span>
            </span>
          )}
        </div>
      </div>

      <!-- Hero Card (Neo-Brutal Pop White Card) -->
      <div class="bg-white border-[2.5px] border-black shadow-[5px_5px_0px_#000] sm:shadow-[6px_6px_0px_#000] p-6 sm:p-10 mb-8 rounded-2xl relative overflow-hidden">
        <!-- Top Badge Stickers -->
        <div class="flex flex-wrap items-center gap-2 mb-5">
          <span class="bg-slate-100 text-black border-2 border-black shadow-[2px_2px_0px_#000] font-mono font-black text-xs px-3 py-1 rounded-lg">
            ${data.ticker}
          </span>
          <span class="bg-[#FFE600] text-black border-2 border-black shadow-[2px_2px_0px_#000] font-mono font-black text-xs px-3 py-1 rounded-lg">
            YC {data.batch}
          </span>
          <span class="bg-[#93C5FD] text-black border border-black shadow-[1px_1px_0px_#000] font-mono font-bold text-xs px-3 py-1 rounded-lg">
            {data.stage}
          </span>
          <span class="bg-[#34D399] text-black border border-black shadow-[1px_1px_0px_#000] font-mono font-black text-xs px-3 py-1 rounded-lg">
            💰 {data.totalRaised} Raised
          </span>
          {data.badge && (
            <span class="bg-[#FF5E7E] text-black border-2 border-black shadow-[2px_2px_0px_#000] font-mono font-bold text-xs px-3 py-1 rounded-lg uppercase">
              {data.badge}
            </span>
          )}
        </div>

        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 sm:gap-8">
          <div class="flex items-start gap-4 sm:gap-6 flex-1">
            <img
              src={data.logo}
              alt={`${data.name} logo`}
              class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover border-2 border-black shadow-[3px_3px_0px_#000] bg-white flex-shrink-0"
              onerror="this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=120&auto=format&fit=crop&q=80'"
            />
            <div class="flex-1 min-w-0">
              <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight leading-tight break-words">
                {data.name}
              </h1>
              <p class="text-base sm:text-xl text-slate-800 font-medium mt-2 max-w-3xl leading-relaxed">
                {data.tagline}
              </p>
              <div class="flex flex-wrap gap-1.5 mt-3.5">
                {data.sectors.map((sec: string) => (
                  <span class="bg-yellow-100 text-black border border-black text-xs font-mono font-bold px-2.5 py-0.5 rounded shadow-[1px_1px_0px_#000]">
                    {sec}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-row lg:flex-col gap-2.5 flex-shrink-0 w-full lg:w-auto">
            <a
              href={data.website}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 lg:flex-none text-center bg-[#FFE600] hover:bg-[#FACC15] text-black border-2 border-black shadow-[3px_3px_0px_#000] font-mono font-black text-xs sm:text-sm px-6 py-3 rounded-xl hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1.5px_1.5px_0px_#000] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all uppercase"
            >
              Visit Website ↗
            </a>
            {data.careersUrl && (
              <a
                href={data.careersUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 lg:flex-none text-center bg-[#34D399] hover:bg-emerald-400 text-black border-2 border-black shadow-[3px_3px_0px_#000] font-mono font-black text-xs sm:text-sm px-6 py-3 rounded-xl hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1.5px_1.5px_0px_#000] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all uppercase"
              >
                View Jobs ↗
              </a>
            )}
            {data.demoUrl && (
              <a
                href={data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 lg:flex-none text-center bg-white hover:bg-yellow-50 text-black border-2 border-black shadow-[3px_3px_0px_#000] font-mono font-bold text-xs sm:text-sm px-6 py-3 rounded-xl hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1.5px_1.5px_0px_#000] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
              >
                Product Demo ↗
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Stats Bento Grid (6 Pop Color Cards) -->
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-8">
        {/* 1. YC Batch Card (Cadmium Yellow) */}
        <div class="bg-[#FFE600] border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all">
          <div className="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-black/80 mb-2">
            YC BATCH
          </div>
          <div class="text-xl sm:text-3xl font-black font-mono text-black">
            YC {data.batch}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-black/80 mt-1">
            Y Combinator Cohort
          </div>
        </div>

        {/* 2. Stage Card (Cobalt / Sky Blue) */}
        <div class="bg-[#93C5FD] border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all">
          <div class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-black/80 mb-2">
            FINANCING STAGE
          </div>
          <div class="text-xl sm:text-3xl font-black font-mono text-black">
            {data.stage}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-black/80 mt-1">
            Active Round
          </div>
        </div>

        {/* 3. Total Raised Card (Mint Green) */}
        <div class="bg-[#34D399] border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all">
          <div class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-black/80 mb-2">
            TOTAL CAPITAL RAISED
          </div>
          <div class="text-xl sm:text-3xl font-black font-mono text-black">
            {data.totalRaised}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-black/80 mt-1">
            Venture & Seed Funding
          </div>
        </div>

        {/* 4. Founders Card (White) */}
        <div class="bg-white border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all">
          <div class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-slate-600 mb-2">
            FOUNDERS
          </div>
          <div class="text-base sm:text-lg font-black font-mono text-black line-clamp-2">
            {data.founders.join(', ')}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-slate-600 mt-1">
            Founding Leadership
          </div>
        </div>

        {/* 5. Location Card (White) */}
        <div class="bg-white border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all">
          <div class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-slate-600 mb-2">
            HEADQUARTERS
          </div>
          <div class="text-base sm:text-lg font-black font-mono text-black">
            📍 {data.location.city}{data.location.state ? `, ${data.location.state}` : ''}, {data.location.country}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-slate-600 mt-1">
            Global Operations
          </div>
        </div>

        {/* 6. Hiring Status Card (Coral Pink or Mint Green) */}
        <div class={`${data.hiring ? 'bg-[#34D399]' : 'bg-[#FF5E7E]'} border-[2.5px] border-black shadow-[4px_4px_0px_#000] p-4 sm:p-5 rounded-2xl flex flex-col justify-between hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#000] transition-all`}>
          <div class="text-[10px] sm:text-xs font-mono font-extrabold uppercase tracking-wider text-black/80 mb-2">
            HIRING STATUS
          </div>
          <div class="text-xl sm:text-2xl font-black font-mono text-black">
            {data.hiring ? `🔥 Actively Hiring` : 'Paused'}
          </div>
          <div class="text-[10px] sm:text-xs font-mono font-bold text-black/80 mt-1">
            {data.hiring
              ? `${data.openRolesCount > 0 ? `${data.openRolesCount} Open Positions` : 'Engineering Roles Available'}`
              : 'Direct Inquiries Only'}
          </div>
        </div>
      </div>

      <!-- Tech Stack Section with Sticker Tags -->
      {data.techStack && data.techStack.length > 0 && (
        <div class="bg-white border-[2.5px] border-black shadow-[5px_5px_0px_#000] p-6 sm:p-8 rounded-2xl mb-8">
          <div class="flex items-center justify-between mb-4 pb-3 border-b-2 border-black flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <span class="text-xl">🛠️</span>
              <h2 class="text-base sm:text-xl font-black font-mono uppercase tracking-tight text-black">
                Core Engineering & Tech Stack
              </h2>
            </div>
            <span class="text-xs font-mono font-bold bg-[#FFE600] border-2 border-black px-2.5 py-1 rounded-lg shadow-[1.5px_1.5px_0px_#000]">
              {data.techStack.length} Technologies Listed
            </span>
          </div>
          <div class="flex flex-wrap gap-2 sm:gap-2.5">
            {data.techStack.map((tech: string) => (
              <span class="bg-[#F7F2E8] text-black border-2 border-black font-mono font-bold text-xs sm:text-sm px-3.5 py-1.5 rounded-xl shadow-[2px_2px_0px_#000]">
                {tech}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- High-Contrast Markdown Body (Problem, Solution, Innovation, Team) -->
      <div class="bg-white border-[2.5px] border-black shadow-[5px_5px_0px_#000] sm:shadow-[6px_6px_0px_#000] p-6 sm:p-10 rounded-2xl">
        <div class="text-xs font-mono font-black uppercase tracking-wider text-slate-500 mb-6 flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#FFE600] border border-black"></span>
          <span>Startup Deep Dive & Architectural Breakthrough</span>
        </div>
        <article class="prose prose-slate max-w-none prose-headings:font-black prose-headings:text-black prose-headings:tracking-tight prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:border-b-2 prose-h2:border-black prose-h2:pb-2 prose-h2:mt-8 prose-h2:mb-4 prose-p:text-slate-800 prose-p:text-base sm:prose-p:text-lg prose-p:leading-relaxed prose-strong:text-black prose-strong:font-black prose-li:text-slate-800 prose-li:text-base prose-ul:my-4 prose-li:my-1">
          <Content />
        </article>
      </div>
    </div>
  </div>
</Layout>
