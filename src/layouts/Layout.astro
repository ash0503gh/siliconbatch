---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "The radar for Physical AI, Robotics, Advanced Electronics, and Frontier Hardware Accelerators. Real-time application countdowns & deal terms.",
} = Astro.props;
const currentPath = Astro.url.pathname;
const isCompanies = currentPath.startsWith('/companies');
const isPrograms = !isCompanies;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content="SiliconBatch" />
    <title>{title} | SiliconBatch</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700;800&family=JetBrains+Mono:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#F7F2E8] text-black min-h-screen flex flex-col font-sans selection:bg-[#FFE600] selection:text-black relative">
    <!-- Top Navigation (Neo-Brutal Pop Header) -->
    <header class="border-b-[2.5px] border-black bg-[#F7F2E8] sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group flex-shrink-0">
          <div class="w-9 h-9 rounded-lg bg-[#FFE600] border-2 border-black shadow-[2px_2px_0px_#000] flex items-center justify-center font-mono font-black text-black text-lg group-hover:translate-x-[1px] group-hover:translate-y-[1px] group-hover:shadow-[1px_1px_0px_#000] transition-all">
            ⚡
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xl font-black tracking-tight text-black group-hover:text-amber-600 transition-colors">
                SiliconBatch
              </span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-[#FFE600] text-black border-2 border-black font-extrabold shadow-[1.5px_1.5px_0px_#000]">
                v2.4
              </span>
            </div>
            <div class="text-[10px] font-mono text-slate-700 font-semibold hidden lg:block">
              Physical AI · Robotics · YC Startups
            </div>
          </div>
        </a>

        <!-- Top-Level Two Tabs Switcher (Desktop) -->
        <nav class="hidden md:flex items-center gap-2.5 font-mono text-xs" aria-label="Primary Navigation">
          <a
            href="/"
            class={isPrograms
              ? "bg-black text-white border-2 border-black shadow-[2px_2px_0px_#000] font-bold px-3.5 py-1.5 rounded-xl transition-all flex items-center gap-1.5"
              : "bg-white text-black border-2 border-black hover:bg-yellow-200 shadow-[1.5px_1.5px_0px_#000] font-medium hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_#000] px-3.5 py-1.5 rounded-xl transition-all flex items-center gap-1.5"
            }
          >
            <span>⚡ Accelerator Programs</span>
          </a>
          <a
            href="/companies"
            class={isCompanies
              ? "bg-black text-white border-2 border-black shadow-[2px_2px_0px_#000] font-bold px-3.5 py-1.5 rounded-xl transition-all flex items-center gap-1.5"
              : "bg-white text-black border-2 border-black hover:bg-yellow-200 shadow-[1.5px_1.5px_0px_#000] font-medium hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_#000] px-3.5 py-1.5 rounded-xl transition-all flex items-center gap-1.5"
            }
          >
            <span>🚀 YC Startups</span>
          </a>
        </nav>

        <!-- Navigation Links -->
        <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
          <a
            href="https://github.com/ash0503gh/siliconbatch"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono font-bold text-black bg-white hover:bg-yellow-50 px-2.5 sm:px-3.5 py-1.5 rounded-xl border-2 border-black shadow-[2px_2px_0px_#000] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_#000] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all flex items-center gap-1"
          >
            <span>GitHub</span>
            <span class="text-[10px] font-bold">↗</span>
          </a>
          <a
            href="https://github.com/ash0503gh/siliconbatch/issues/new"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono font-black text-black bg-[#FFE600] hover:bg-[#FACC15] px-2.5 sm:px-4 py-1.5 rounded-xl border-2 border-black shadow-[2.5px_2.5px_0px_#000] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1.5px_1.5px_0px_#000] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
          >
            <span class="hidden sm:inline">{isCompanies ? "+ Submit Startup" : "+ Submit Program"}</span>
            <span class="sm:hidden">+ Submit</span>
          </a>
        </div>
      </div>

      <!-- Top-Level Two Tabs Switcher (Mobile Responsive Bar) -->
      <nav class="md:hidden flex items-center justify-center gap-2 px-3 py-2 border-t-2 border-black/10 bg-[#F4EFE6] font-mono text-xs" aria-label="Mobile Primary Navigation">
        <a
          href="/"
          class={`flex-1 text-center justify-center py-2 ${isPrograms
            ? "bg-black text-white border-2 border-black shadow-[2px_2px_0px_#000] font-bold rounded-xl transition-all flex items-center gap-1.5"
            : "bg-white text-black border-2 border-black hover:bg-yellow-200 shadow-[1.5px_1.5px_0px_#000] font-medium rounded-xl transition-all flex items-center gap-1.5"
          }`}
        >
          <span>⚡ Programs</span>
        </a>
        <a
          href="/companies"
          class={`flex-1 text-center justify-center py-2 ${isCompanies
            ? "bg-black text-white border-2 border-black shadow-[2px_2px_0px_#000] font-bold rounded-xl transition-all flex items-center gap-1.5"
            : "bg-white text-black border-2 border-black hover:bg-yellow-200 shadow-[1.5px_1.5px_0px_#000] font-medium rounded-xl transition-all flex items-center gap-1.5"
          }`}
        >
          <span>🚀 YC Startups</span>
        </a>
      </nav>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1 relative z-10 w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t-[2.5px] border-black bg-[#F4EFE6] mt-16 sm:mt-24 py-10 sm:py-12 font-mono text-xs text-slate-800 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
        <div class="flex flex-col sm:flex-row items-center gap-2">
          <span class="font-black text-black text-sm">⚡ SiliconBatch</span>
          <span class="text-slate-400 hidden sm:inline">·</span>
          <span class="text-slate-700 font-medium">The High-Density Radar for Physical AI & Hardware Accelerators.</span>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-4 text-[11px] font-bold">
          <span class="px-2.5 py-1 rounded-md bg-white text-black border-2 border-black shadow-[1.5px_1.5px_0px_#000]">Verified Deadlines</span>
          <span class="px-2.5 py-1 rounded-md bg-white text-black border-2 border-black shadow-[1.5px_1.5px_0px_#000]">100% Founder IP</span>
          <a
            href="https://github.com/ash0503gh/siliconbatch"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1 rounded-md bg-[#FFE600] text-black border-2 border-black shadow-[1.5px_1.5px_0px_#000] hover:bg-yellow-400 transition-colors"
          >
            Open Source ↗
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
