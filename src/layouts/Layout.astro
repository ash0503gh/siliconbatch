---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "The radar for Physical AI, Robotics, Advanced Electronics, and Frontier Hardware Accelerators. Real-time application countdowns & deal terms.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | SiliconBatch</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#06090f] text-[#e6ecf4] min-h-screen flex flex-col font-sans selection:bg-[#3b82f6]/30 selection:text-white">
    <!-- Top Navigation -->
    <header class="border-b border-[#1b2540] bg-[#0c1018]/90 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-[#3b82f6] to-[#06b6d4] flex items-center justify-center shadow-lg shadow-[#3b82f6]/20 font-mono font-black text-white text-lg">
            ⚡
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-lg font-black tracking-tight text-[#e6ecf4] group-hover:text-[#3b82f6] transition-colors">
                SiliconBatch
              </span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#3b82f6]/20 text-[#3b82f6] border border-[#3b82f6]/40 font-bold">
                v1.0
              </span>
            </div>
            <div class="text-[10px] font-mono text-[#556580]">
              Physical AI · Robotics · Hardware Radar
            </div>
          </div>
        </a>

        <!-- Middle Live Status -->
        <div class="hidden md:flex items-center gap-2 text-xs font-mono bg-[#131a28] px-3 py-1.5 rounded-full border border-[#1b2540]">
          <span class="w-2 h-2 rounded-full bg-[#22c55e] animate-pulse"></span>
          <span class="text-[#b4c0d4]">RADAR ACTIVE</span>
          <span class="text-[#556580]">|</span>
          <span class="text-[#fbbf24]">OPEN BATCHES ONLY</span>
        </div>

        <!-- Navigation Links -->
        <div class="flex items-center gap-3">
          <a
            href="https://github.com/ash0503gh/siliconbatch"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono text-[#b4c0d4] hover:text-white flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[#1b2540] bg-[#131a28] hover:border-[#2a3a5c] transition-colors"
          >
            <span>GitHub</span>
            <span class="text-[10px] text-[#556580]">↗</span>
          </a>
          <a
            href="https://f.inc/blueprint"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex text-xs font-mono font-bold text-white bg-[#3b82f6] hover:bg-[#2563eb] px-3.5 py-1.5 rounded-lg transition-colors shadow-sm"
          >
            + Submit Program
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#1b2540] bg-[#0c1018] mt-20 py-10 font-mono text-xs text-[#556580]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <div>
          <span class="font-bold text-[#b4c0d4]">SiliconBatch</span> · Aggregator for Physical AI, Robotics, and Advanced Electronics Accelerators.
        </div>
        <div class="flex items-center gap-4 text-[11px]">
          <span>Only Open Deadlines Shown</span>
          <span>·</span>
          <span>Terms & IP 100% Verified</span>
          <span>·</span>
          <a href="https://github.com/ash0503gh/siliconbatch" class="text-[#3b82f6] hover:underline">
            Repo
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
